# New Start MD — environment. Copy to .env.local for local dev. Never commit secrets.

# Public site + app URLs
NEXT_PUBLIC_SITE_URL=https://newstartmd.com
NEXT_PUBLIC_APP_URL=https://app.newstartmd.com

# Partner portal (a separate app). When set, referral clicks and /start
# submissions post attribution to <portal>/api/referral. Leave empty until the
# partner portal is deployed — the calls are a no-op while unset.
NEXT_PUBLIC_PORTAL_URL=

# Launch switches
#   NEXT_PUBLIC_APP_LIVE=true     -> opens signup + shows Sign in (set once the app is live)
#   NEXT_PUBLIC_SHOW_SIGN_IN=true -> shows Sign in only
NEXT_PUBLIC_APP_LIVE=
NEXT_PUBLIC_SHOW_SIGN_IN=

# LocumTele booking calendar the /start capture hands off to (optional pre-launch)
NEXT_PUBLIC_BOOKING_URL=

# Lead / application notifications. Delivery tries EVERY transport you set
# (email + webhook); with none set, submissions are logged server-side so they
# are never lost. Set at least one before launch so leads actually reach you.
#
#   Email (Resend): set RESEND_API_KEY (+ verify your sending domain in Resend).
#   Webhook: set CONTACT_WEBHOOK_URL (Slack / Zapier / n8n / Make).
RESEND_API_KEY=
NOTIFY_FROM=New Start MD <noreply@newstartmd.com>
CONTACT_WEBHOOK_URL=
# Destination inboxes (optional; fall back to the site's hello@ / partners@).
CONTACT_INBOX=
LEADS_INBOX=
PARTNER_INBOX=

# Google Search Console meta-tag verification (optional; DNS TXT preferred)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Pricing range shown across the site (see src/lib/pricing.ts). Placeholders
# render until set. NEXT_PUBLIC_PRICE_CONFIRMED=true drops the "indicative" tag.
NEXT_PUBLIC_PRICE_LOW=
NEXT_PUBLIC_PRICE_HIGH=
NEXT_PUBLIC_PRICE_CONFIRMED=

# GEN Health handoff. The /start form hands the lead into GEN Health's hosted
# assessment/checkout (which collects DOB, address and medical history — this
# site never does), carrying partner attribution. Set GENHEALTH_ASSESSMENT_URL
# to the GEN-hosted assessment-first checkout link to turn the live handoff on;
# until then the lead is captured to the inbox and the form confirms normally.
GENHEALTH_ASSESSMENT_URL=
# GEN Health V2 Client API (server-only). Key is set; reserved for future
# server-side reads (patient lookup, product catalog). Not needed for the
# redirect handoff above.
GENHEALTH_API_KEY=
GENHEALTH_BASE_URL=https://api.gen-health.app
# Signing secret for the order webhook. Register the endpoint in GEN Health as
#   POST https://newstartmd.com/api/genhealth/webhook
# with this shared secret; the receiver verifies the x-webhook-signature HMAC,
# dedupes on event_id, and writes a provenance entry (pharmacy/batch/COA) that
# powers /verify. Until it is set the endpoint returns 503 (exists, disabled).
GENHEALTH_WEBHOOK_SECRET=
